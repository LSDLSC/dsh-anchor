# 复制成环境文件或写进 systemd Environment=
DSH_HOME=/home/user/.dsh
MEMORY_DIR=/home/user/.dsh/memory
BARE_DIR=/srv/git
GITHUB_REMOTE=github
GUARD_LOG=/var/log/dsh-memory-guard.log
RESTART_CMD=systemctl restart dsh-web.service
# dsh-anchor 仓库路径（dsh-anchor-sync 用来比对线上脚本）
ANCHOR_REPO=/home/user/workspace/anchor
