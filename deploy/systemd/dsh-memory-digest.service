[Unit]
Description=DSH memory digest (session -> journal)
After=network.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/anchor.env
Environment=HOME=/root
Environment=DSH_HOME=/home/user/.dsh
Environment=MEMORY_DIR=/home/user/.dsh/memory
ExecStart=/usr/local/bin/node /usr/local/bin/memory_digest.mjs 24
Nice=10
